<?xml version='1.0' encoding='utf-8' ?>

<!-- Tableau Workbook - Salary Analysis Dashboard -->
<workbook originalversion='18.1' source-build='2024.1.0' version='2024.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <AutoCreateAndUpdateDPIAwareness />
    <SheetIdentifierTracking />
    <WindowsPersistSimpleIdentifiers />
  </document-format-change-manifest>

  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>

  <datasources>
    <datasource inline='true' name='federated.salary_analysis' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='salary_analysis_dataset' name='textscan.salary_analysis'>
            <connection class='textscan' directory='.' filename='salary_analysis_dataset.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.salary_analysis' name='salary_analysis_dataset.csv' table='[salary_analysis_dataset#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='Employee_ID' ordinal='0' />
            <column datatype='integer' name='Work_Year' ordinal='1' />
            <column datatype='string' name='Experience_Level' ordinal='2' />
            <column datatype='string' name='Employment_Type' ordinal='3' />
            <column datatype='string' name='Job_Title' ordinal='4' />
            <column datatype='integer' name='Salary' ordinal='5' />
            <column datatype='string' name='Salary_Currency' ordinal='6' />
            <column datatype='real' name='Salary_in_USD' ordinal='7' />
            <column datatype='string' name='Employee_Residence' ordinal='8' />
            <column datatype='integer' name='Remote_Ratio' ordinal='9' />
            <column datatype='string' name='Company_Location' ordinal='10' />
            <column datatype='string' name='Company_Size' ordinal='11' />
            <column datatype='string' name='Department' ordinal='12' />
            <column datatype='string' name='Education_Level' ordinal='13' />
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>Employee_ID</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Employee_ID]</local-name>
            <parent-name>[salary_analysis_dataset.csv]</parent-name>
            <type-name>string</type-name>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Work_Year</remote-name>
            <remote-type>20</remote-type>
            <local-name>[Work_Year]</local-name>
            <parent-name>[salary_analysis_dataset.csv]</parent-name>
            <type-name>integer</type-name>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Experience_Level</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Experience_Level]</local-name>
            <parent-name>[salary_analysis_dataset.csv]</parent-name>
            <type-name>string</type-name>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Job_Title</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Job_Title]</local-name>
            <parent-name>[salary_analysis_dataset.csv]</parent-name>
            <type-name>string</type-name>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>Salary_in_USD</remote-name>
            <remote-type>5</remote-type>
            <local-name>[Salary_in_USD]</local-name>
            <parent-name>[salary_analysis_dataset.csv]</parent-name>
            <type-name>real</type-name>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column caption='Employee ID' datatype='string' name='[Employee_ID]' role='dimension' type='nominal' />
      <column caption='Work Year' datatype='integer' name='[Work_Year]' role='dimension' type='quantitative' />
      <column caption='Experience Level' datatype='string' name='[Experience_Level]' role='dimension' type='nominal' />
      <column caption='Employment Type' datatype='string' name='[Employment_Type]' role='dimension' type='nominal' />
      <column caption='Job Title' datatype='string' name='[Job_Title]' role='dimension' type='nominal' />
      <column caption='Salary in USD' datatype='real' name='[Salary_in_USD]' role='measure' type='quantitative' default-format='c"$#,##0"' />
      <column caption='Employee Residence' datatype='string' name='[Employee_Residence]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Remote Ratio' datatype='integer' name='[Remote_Ratio]' role='dimension' type='ordinal' />
      <column caption='Company Location' datatype='string' name='[Company_Location]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Company Size' datatype='string' name='[Company_Size]' role='dimension' type='nominal' />
      <column caption='Department' datatype='string' name='[Department]' role='dimension' type='nominal' />
      <column caption='Education Level' datatype='string' name='[Education_Level]' role='dimension' type='nominal' />

      <!-- Calculated Fields -->
      <column caption='Average Salary USD' datatype='real' name='[Calculated_Avg_Salary]' role='measure' type='quantitative' default-format='c"$#,##0"'>
        <calculation class='tableau' formula='AVG([Salary_in_USD])' />
      </column>
      <column caption='Total Employees Analyzed' datatype='integer' name='[Calculated_Record_Count]' role='measure' type='quantitative' default-format='n#,##0'>
        <calculation class='tableau' formula='COUNT([Employee_ID])' />
      </column>
      <column caption='Remote Work Rate %' datatype='real' name='[Calculated_Remote_Work_Pct]' role='measure' type='quantitative' default-format='p0.0%'>
        <calculation class='tableau' formula='SUM(IF [Remote_Ratio] = 100 THEN 1 ELSE 0 END) / COUNT([Employee_ID])' />
      </column>

      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.5' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
    </datasource>
  </datasources>

  <worksheets>
    <!-- KPI 1: Average Salary -->
    <worksheet name='KPI_Avg_Salary'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='12' fontcolor='#1E293B'>AVG SALARY (USD)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table />
    </worksheet>

    <!-- KPI 2: Total Employees -->
    <worksheet name='KPI_Total_Employees'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='12' fontcolor='#1E293B'>TOTAL EMPLOYEES ANALYZED</run>
          </formatted-text>
        </title>
      </layout-options>
      <table />
    </worksheet>

    <!-- KPI 3: Top Paying Role -->
    <worksheet name='KPI_Top_Paying_Role'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='12' fontcolor='#1E293B'>TOP PAYING ROLE (AI ARCHITECT)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table />
    </worksheet>

    <!-- KPI 4: Remote Work Rate -->
    <worksheet name='KPI_Remote_Work_Pct'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='12' fontcolor='#1E293B'>FULLY REMOTE WORK RATE</run>
          </formatted-text>
        </title>
      </layout-options>
      <table />
    </worksheet>

    <!-- Chart 1: Average Salary by Job Title & Experience Level -->
    <worksheet name='Bar_Salary_by_Title_Exp'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='14' fontcolor='#0F172A'>Average Salary by Job Title &amp; Experience Level</run>
          </formatted-text>
        </title>
      </layout-options>
      <table />
    </worksheet>

    <!-- Chart 2: YoY Salary Growth Trend -->
    <worksheet name='Line_Salary_Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='14' fontcolor='#0F172A'>Multi-Year Salary Growth Trend (2021–2024)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table />
    </worksheet>

    <!-- Chart 3: Geographic Salary Map -->
    <worksheet name='Map_Global_Salary'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='14' fontcolor='#0F172A'>Global Salary Distribution by Country</run>
          </formatted-text>
        </title>
      </layout-options>
      <table />
    </worksheet>

    <!-- Chart 4: Heatmap Remote vs Company Size -->
    <worksheet name='Heatmap_Remote_CompanySize'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='14' fontcolor='#0F172A'>Salary Heatmap: Company Size vs Remote Work Ratio</run>
          </formatted-text>
        </title>
      </layout-options>
      <table />
    </worksheet>

    <!-- Chart 5: Education Level & Department Breakdown -->
    <worksheet name='Donut_Education_Dept'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='14' fontcolor='#0F172A'>Compensation by Department &amp; Education Level</run>
          </formatted-text>
        </title>
      </layout-options>
      <table />
    </worksheet>

    <!-- Chart 6: Experience Level Distribution -->
    <worksheet name='Box_Experience_Salary'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold' fontsize='14' fontcolor='#0F172A'>Salary Distribution Across Experience Levels</run>
          </formatted-text>
        </title>
      </layout-options>
      <table />
    </worksheet>
  </worksheets>

  <dashboards>
    <dashboard name='Salary Analysis Dashboard'>
      <style />
      <size maxheight='1080' maxwidth='1920' minheight='800' minwidth='1200' preset-index='0' type='preset' />
      <zones>
        <zone h='100000' id='1' type-name='layout-basic' w='100000' x='0' y='0'>
          <zone h='9400' id='2' name='Title' type-name='title' w='100000' x='0' y='0'>
            <formatted-text>
              <run fontname='Tableau Bold' fontsize='20' fontcolor='#0F172A'>Salary Analysis Dashboard</run>
              <run fontname='Tableau' fontsize='12' fontcolor='#64748B'> | Executive Compensation &amp; Workforce Intelligence</run>
            </formatted-text>
          </zone>
          <zone h='18000' id='3' type-name='layout-flow' w='100000' x='0' y='9400'>
            <zone h='18000' id='4' name='KPI_Avg_Salary' w='25000' x='0' y='9400' />
            <zone h='18000' id='5' name='KPI_Total_Employees' w='25000' x='25000' y='9400' />
            <zone h='18000' id='6' name='KPI_Top_Paying_Role' w='25000' x='50000' y='9400' />
            <zone h='18000' id='7' name='KPI_Remote_Work_Pct' w='25000' x='75000' y='9400' />
          </zone>
          <zone h='36000' id='8' type-name='layout-flow' w='100000' x='0' y='27400'>
            <zone h='36000' id='9' name='Bar_Salary_by_Title_Exp' w='50000' x='0' y='27400' />
            <zone h='36000' id='10' name='Line_Salary_Trend' w='50000' x='50000' y='27400' />
          </zone>
          <zone h='36000' id='11' type-name='layout-flow' w='100000' x='0' y='63400'>
            <zone h='36000' id='12' name='Map_Global_Salary' w='33333' x='0' y='63400' />
            <zone h='36000' id='13' name='Heatmap_Remote_CompanySize' w='33333' x='33333' y='63400' />
            <zone h='36000' id='14' name='Donut_Education_Dept' w='33334' x='66666' y='63400' />
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
</workbook>
